    <SSIS16TransferTaskPath Condition="'$(SSIS16TransferTaskPath)' == '' and Exists('$(ProgramFiles)\Microsoft SQL Server\160\DTS\Tasks\Microsoft.SqlServer.TransferSqlServerObjectsTask.dll')">$(ProgramFiles)\Microsoft SQL Server\160\DTS\Tasks\Microsoft.SqlServer.TransferSqlServerObjectsTask.dll</SSIS16TransferTaskPath>
    <SSIS16TransferTaskPath Condition="'$(SSIS16TransferTaskPath)' == ''">$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\Microsoft.SqlServer.TransferSqlServerObjectsTask\v4.0_16.0.0.0__89845dcd8080cc91\Microsoft.SqlServer.TransferSqlServerObjectsTask.dll</SSIS16TransferTaskPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SsisAiRuntime.Ssis16\SsisAiRuntime.Ssis16.csproj" />
    <ProjectReference Include="..\..\src\SsisAiRuntime.Cli\SsisAiRuntime.Cli.csproj" />
    <ProjectReference Include="..\..\src\SsisAiRuntime.FlowRunner\SsisAiRuntime.FlowRunner.csproj" />
    <ProjectReference Include="..\..\src\SsisAiRuntime.MutationHost\SsisAiRuntime.MutationHost.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
