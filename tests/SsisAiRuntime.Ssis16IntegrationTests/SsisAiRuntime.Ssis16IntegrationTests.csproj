<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <SSIS16BinnPath Condition="'$(SSIS16BinnPath)' == ''">$(ProgramFiles)\Microsoft SQL Server\160\DTS\Binn</SSIS16BinnPath>
    <SSIS16ManagedDtsPath Condition="'$(SSIS16ManagedDtsPath)' == '' and Exists('$(SSIS16BinnPath)\Microsoft.SQLServer.ManagedDTS.dll')">$(SSIS16BinnPath)\Microsoft.SQLServer.ManagedDTS.dll</SSIS16ManagedDtsPath>
    <SSIS16ManagedDtsPath Condition="'$(SSIS16ManagedDtsPath)' == ''">$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\Microsoft.SQLServer.ManagedDTS\v4.0_16.0.0.0__89845dcd8080cc91\Microsoft.SQLServer.ManagedDTS.dll</SSIS16ManagedDtsPath>
    <SSIS16PipelineWrapPath Condition="'$(SSIS16PipelineWrapPath)' == '' and Exists('$(SSIS16BinnPath)\Microsoft.SqlServer.DTSPipelineWrap.dll')">$(SSIS16BinnPath)\Microsoft.SqlServer.DTSPipelineWrap.dll</SSIS16PipelineWrapPath>
    <SSIS16PipelineWrapPath Condition="'$(SSIS16PipelineWrapPath)' == ''">$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\Microsoft.SqlServer.DTSPipelineWrap\v4.0_16.0.0.0__89845dcd8080cc91\Microsoft.SqlServer.DTSPipelineWrap.dll</SSIS16PipelineWrapPath>
    <SSIS16RuntimeWrapPath Condition="'$(SSIS16RuntimeWrapPath)' == '' and Exists('$(SSIS16BinnPath)\Microsoft.SqlServer.DTSRuntimeWrap.dll')">$(SSIS16BinnPath)\Microsoft.SqlServer.DTSRuntimeWrap.dll</SSIS16RuntimeWrapPath>
    <SSIS16RuntimeWrapPath Condition="'$(SSIS16RuntimeWrapPath)' == ''">$(WINDIR)\Microsoft.NET\assembly\GAC_32\Microsoft.SqlServer.DTSRuntimeWrap\v4.0_16.0.0.0__89845dcd8080cc91\Microsoft.SqlServer.DTSRuntimeWrap.dll</SSIS16RuntimeWrapPath>
    <SSIS16ExecPackageTaskWrapPath Condition="'$(SSIS16ExecPackageTaskWrapPath)' == '' and Exists('$(SSIS16BinnPath)\Microsoft.SqlServer.ExecPackageTaskWrap.dll')">$(SSIS16BinnPath)\Microsoft.SqlServer.ExecPackageTaskWrap.dll</SSIS16ExecPackageTaskWrapPath>
